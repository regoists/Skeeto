    {L"内存显示 HUD", L"Memory HUD", L"显示游戏缓存用量、剩余虚拟地址空间和当前客户端实体数", L"Game cache usage, remaining virtual address space and current client entity count", L"自定义 HUD > 内存显示 HUD", L"Custom HUD > Memory HUD", L"", {49, 0, 0}, false, false}, // Text_b7484dd9
    {L"简洁版导演 HUD", L"Compact Director HUD", L"阶段名与原版导演 HUD 相同；转阶段弹出或常驻，可在子页切换", L"Stock Director phase names; choose phase-change popups or always visible on the subpage", L"自定义 HUD > 简洁版导演 HUD", L"Custom HUD > Compact Director HUD", L"", {41, 0, 0}, false, false}, // Text_2c861b8b
    {L"队友投掷物提示 HUD", L"Teammate throwable alert HUD", L"确认队友的实际投射物及投掷者后显示约 5 秒；传递道具不触发，不依赖 weapon_fire，不扫描实体", L"Shows a confirmed teammate projectile and its thrower for about 5 seconds; item transfers do not trigger it; no weapon_fire or entity scans", L"自定义 HUD > 队友投掷物提示 HUD", L"Custom HUD > Teammate throwable alert HUD", L"", {44, 0, 0}, false, false}, // Text_8bcd254b
    {L"在场特感数量 HUD", L"Active special infected count HUD", L"分别显示当前已生成且存活的特感总数与 Smoker 数量；每 0.5 秒检查一次玩家槽位", L"Spawned, living special infected total and Smoker count; checks player slots every 0.5 seconds", L"自定义 HUD > 在场特感数量 HUD", L"Custom HUD > Active special infected count HUD", L"", {50, 0, 0}, false, false}, // Text_40a4abe2
    {L"惊扰女巫提示 HUD", L"Witch startled alert HUD", L"监听 witch_harasser_set，显示玩家名或人机角色名约 4.5 秒；不用 userid，不扫描实体", L"Listens for witch_harasser_set; player or bot character name for about 4.5 seconds; no userid or entity scans", L"自定义 HUD > 惊扰女巫提示 HUD", L"Custom HUD > Witch startled alert HUD", L"", {52, 0, 0}, false, false}, // Text_7f020204
    {L"Tank 举石预警 HUD", L"Tank rock windup alert HUD", L"举石起手就闪，并标出 E砖 / 右键砖 / R砖；砸中或打碎提前灭；默认关", L"Flashes at rock windup; labels E / right-click / R throws; clears early on impact or destruction; off by default", L"自定义 HUD > Tank 举石预警 HUD", L"Custom HUD > Tank rock windup alert HUD", L"", {54, 0, 0}, false, false}, // Text_2e869c8b
    {L"特感预警 HUD", L"Special infected alert HUD", L"六种特感扁平图标的出生/近身提示；依赖“大幅降低无声特感发生的概率”，可单独调整位置与大小。", L"Spawn/proximity icons for six SI types; requires Reduce silent special infected; position and size adjustable.", L"自定义 HUD > 特感预警 HUD", L"Custom HUD > Special infected alert HUD", L"", {58, 0, 0}, false, false}, // Text_fd83caec
    {L"开麦提示 HUD", L"Voice activity HUD", L"有人按麦时在准星附近显示喇叭和真人玩家 ID，无底框；自己按麦也会显示。默认关。", L"Speaker icon and human player ID near the crosshair while speaking, including yourself. No background; off by default.", L"自定义 HUD > 开麦提示 HUD", L"Custom HUD > Voice activity HUD", L"", {59, 0, 0}, false, false}, // Text_da7bd7d8
    {L"高爆弹 / 燃烧弹 / 激光 HUD", L"Explosive / incendiary ammo / laser HUD", L"主武器带高爆弹、燃烧弹或激光瞄准器时显示对应图标；特殊弹药打完即消失，激光会一直留着。无底框、无文字。默认关。", L"Primary weapon upgrade icons; special ammo disappears when spent, laser stays. No text or background; off by default.", L"自定义 HUD > 高爆弹 / 燃烧弹 / 激光 HUD", L"Custom HUD > Explosive / incendiary ammo / laser HUD", L"", {60, 0, 0}, false, false}, // Text_469fd89c
    {L"击杀列表 HUD", L"Kill feed HUD", L"右上角击杀列表：只显示玩家、特感和女巫，不含普通感染者。开启后会关掉原版红色击杀记录。默认关。", L"Top-right kill feed for players, SI and Witches, excluding common infected. Hides stock red kill feed; off by default.", L"自定义 HUD > 击杀列表 HUD", L"Custom HUD > Kill feed HUD", L"", {61, 0, 0}, false, false}, // Text_d627b7c0
    {L"队友黑白状态提示HUD", L"Teammate black-and-white alert HUD", L"队友进入黑白时，屏幕左侧提示约 5 秒。默认关。", L"Left-side alert for about 5 seconds when a teammate turns black-and-white. Off by default.", L"自定义 HUD > 队友黑白状态提示HUD", L"Custom HUD > Teammate black-and-white alert HUD", L"", {63, 0, 0}, false, false}, // Text_c150da48
    {L"队友低血量提示HUD", L"Teammate low-health alert HUD", L"队友血量持续在 39 及以下约 10 秒后提示约 5 秒。默认关。", L"A 5-second alert after a teammate stays at 39 HP or below for about 10 seconds. Off by default.", L"自定义 HUD > 队友低血量提示HUD", L"Custom HUD > Teammate low-health alert HUD", L"", {64, 0, 0}, false, false}, // Text_6a1dc3d0
    {L"关键保护提示HUD", L"Critical rescue alert HUD", L"队友救起自己或解除自己被控时提示约 5 秒。默认关。", L"A 5-second alert when a teammate revives or frees you. Off by default.", L"自定义 HUD > 关键保护提示HUD", L"Custom HUD > Critical rescue alert HUD", L"", {65, 0, 0}, false, false}, // Text_506eec02
    {L"互动进度 HUD", L"Interact progress HUD", L"自己正在救人、治疗、灌油等互动时，显示互动进度与剩余秒数；可调位置、大小与字号。默认关。", L"Progress and seconds left while you revive, heal or refuel; position, size and layout are adjustable. Off by default.", L"自定义 HUD > 互动进度 HUD", L"Custom HUD > Interact progress HUD", L"", {66, 0, 0}, false, false}, // TextInteractHudName
    {L"图形化弹药显示 HUD", L"Graphic ammo HUD", L"分段格 / 直线条；与额外弹药数字 HUD 独立。默认关。", L"Segments / straight bar beside the crosshair; independent of the extra ammo number HUD", L"自定义 HUD > 图形化弹药显示 HUD", L"Custom HUD > Graphic ammo HUD", L"", {72, 0, 0}, false, false}, // AmmoGfxEntryName
    {L"自己二倒黑白提示 HUD", L"Own black-and-white HUD", L"自己处于二倒黑白时，屏幕常驻裂心心电图标记（与世界 HUD 队友标记同款），恢复后消失。默认关。", L"While you are black-and-white (revived after two incaps), show the cracked-heart ECG on screen until recovered. Off by default.", L"自定义 HUD > 自己二倒黑白提示 HUD", L"Custom HUD > Own black-and-white HUD", L"", {76, 0, 0}, false, false}, // BwSelfHudEntryName
    {L"TAB 计分面板 HUD", L"Skeeto TAB Board HUD", L"按住 TAB 显示计分面板（最多 32 人，可设）：血量/虚血、倒地/挂边/黑白/被控、主副武器与物品、普感/特感击杀、延迟与头像；对抗分生还者/感染者两组，战役可列出特感。可设单击/双击切换原版计分板。默认关。", L"Hold a bound key for a scoreboard (up to 32 players, adjustable): health / temp health, down / ledge / black-and-white / pinned, weapons and items, kills, ping and avatars. Versus shows Survivors and Infected as two groups; campaign can list special infected. Choose either Skeeto-first or vanilla-first single/double tap behavior in Edit Keys. Off by default.", L"自定义 HUD > TAB 计分面板 HUD", L"Custom HUD > Skeeto TAB Board HUD", L"", {80, 0, 0}, false, false}, // TabBoardEntryName
    {L"章节结算面板 HUD", L"Chapter Stats Panel HUD", L"普通章节过关时冻结本章统计，在过图画面显示：评分总览（可关）、普感 / 特感击杀、爆头、团队贡献，以及可选的特殊操作页；分屏轮播并标出每项最佳。也可按住按键随时查看本章累计。默认关。", L"Freezes this chapter's stats when the safe room door closes on a regular chapter and shows them on the transition screen: optional score overview, common / special kills, headshots, team contribution, and an optional special-ops page, rotating by theme with the best player marked. Hold a key to see the running totals at any time. Off by default.", L"自定义 HUD > 章节结算面板 HUD", L"Custom HUD > Chapter Stats Panel HUD", L"", {81, 0, 0}, false, false}, // ChapStatsEntryName
    {L"Tank 当前仇恨目标 HUD", L"Tank focus target HUD", L"显示 Tank 当前仇恨目标；目标是自己时用红色提醒。默认关。", L"Shows the survivor currently targeted by the Tank. Your own name turns red when the Tank targets you. Default off.", L"自定义 HUD > Tank 当前仇恨目标 HUD", L"Custom HUD > Tank focus target HUD", L"", {105, 0, 0}, false, false}, // TankTargetHudEntryName
    {L"伤害来源 HUD", L"Damage source HUD", L"自己受伤时显示来源和伤害量；默认只显示队友造成的伤害，也可切换为全部来源。默认关。", L"Shows who damaged you and how much. Defaults to teammates only; can include all sources. Default off.", L"自定义 HUD > 伤害来源 HUD", L"Custom HUD > Damage source HUD", L"", {106, 0, 0}, false, false}, // DamageSourceHudEntryName
    {L"黑枪伤害提示 HUD", L"Friendly-fire damage tip HUD", L"自己打中队友时显示受伤者和伤害量；短时间内重复命中会合并。可调整位置和大小。默认关。", L"Shows the teammate and health lost when you hit them. Repeated hits briefly combine. Default off.", L"自定义 HUD > 黑枪伤害提示 HUD", L"Custom HUD > Friendly-fire damage tip HUD", L"", {107, 0, 0}, false, false}, // FriendlyFireHudEntryName
    {L"特感仇恨显示", L"SI hate display", L"列出当前仇恨指向自己的特感（Smoker、Hunter 等，不含 Tank）；有特感仇恨自己时以红色提示。默认关。", L"Lists special infected currently locked onto you (Smoker, Hunter, ...). Turns red while any is targeting you. Default off.", L"自定义 HUD > 特感仇恨显示", L"Custom HUD > SI hate display", L"", {108, 0, 0}, false, false}, // SiAggroHudEntryName
    {L"坐妹惊扰度 HUD", L"Witch startle HUD", L"显示坐妹惊扰度，可选再显示一条游荡怒气细条；数值无变化约 2 秒后隐藏。默认关。", L"Shows how close a Witch is to being startled, with an optional thin bar for wandering rage. Hides after about 2 seconds without change. Default off.", L"自定义 HUD > 坐妹惊扰度 HUD", L"Custom HUD > Witch startle HUD", L"", {109, 0, 0}, false, false}, // WitchRageHudEntryName
    {L"Boss 伤害排行 HUD", L"Boss damage ranking HUD", L"Tank 或 Witch 死亡后，显示 10 秒内各生还者对该次战斗的伤害排行（前 8 名）。默认关。", L"After a Tank or Witch dies, shows each survivor's damage to that fight for 10 seconds (top 8). Default off.", L"自定义 HUD > Boss 伤害排行 HUD", L"Custom HUD > Boss damage ranking HUD", L"", {110, 0, 0}, false, false}, // BossDmgBoardEntryName
    {L"Boss 点燃提示 HUD", L"Boss ignite toast HUD", L"Witch 或 Tank 被点燃时，短暂提示是谁点的火。默认关。", L"Shows a short toast naming who set a Witch or Tank on fire. Default off.", L"自定义 HUD > Boss 点燃提示 HUD", L"Custom HUD > Boss ignite toast HUD", L"", {111, 0, 0}, false, false}, // IgniteHudEntryName
    {L"Witch 血量 HUD", L"Witch HP HUD", L"Witch 受伤时在屏幕显示估算血条（读生还者对 Witch 的检查点伤害累计，客户端无 Witch m_iHealth）；无变化约 2 秒后隐藏。默认关。", L"Shows an estimated Witch HP bar when she takes damage (uses survivor checkpoint Witch damage; Witch entities have no client m_iHealth). Hides after about 2 seconds without change. Default off.", L"自定义 HUD > Witch 血量 HUD", L"Custom HUD > Witch HP HUD", L"", {112, 0, 0}, false, false}, // WitchHpHudEntryName
    {L"红点局提示", L"Laser round notice", L"本章节首次确认可拾取的激光瞄准器时提示 10 秒，可延后提示。只检查客户端已同步的实体，不读地图物资表，也不开物资雷达。可调位置与大小。默认关。", L"Shows one 10-second notice per chapter when a laser sight pickup is first confirmed. May appear later; only entities received by the client. Position and size adjustable. Default off.", L"自定义 HUD > 红点局提示", L"Custom HUD > Laser round notice", L"", {123, 0, 0}, false, false}, // LaserRoundNoticeName
