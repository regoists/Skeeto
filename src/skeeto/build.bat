@echo off
setlocal EnableExtensions EnableDelayedExpansion
cd /d "%~dp0"
set "ROOT=%~dp0..\..\"

rem --- MSVC x86 (same ABI as L4D2 / Necola). Do not fall back to MinGW. ---
set "VSWHERE=%ProgramFiles(x86)%\Microsoft Visual Studio\Installer\vswhere.exe"
if not exist "%VSWHERE%" set "VSWHERE=%ProgramFiles%\Microsoft Visual Studio\Installer\vswhere.exe"
if not exist "%VSWHERE%" (
  echo ERROR: vswhere.exe not found. Install VS 2022 Build Tools with C++ workload.
  exit /b 1
)
set "VSINSTALL="
for /f "usebackq delims=" %%I in (`"%VSWHERE%" -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath`) do set "VSINSTALL=%%I"
if not defined VSINSTALL (
  echo ERROR: MSVC x86 toolset not found. Install Visual Studio C++ tools ^(x86^).
  exit /b 1
)
call "%VSINSTALL%\VC\Auxiliary\Build\vcvarsall.bat" x86 >nul
if errorlevel 1 (
  echo ERROR: vcvarsall.bat x86 failed
  exit /b 1
)
where cl >nul 2>&1
if errorlevel 1 (
  echo ERROR: cl.exe not on PATH after vcvarsall x86
  exit /b 1
)
echo Using MSVC x86:
cl 2>&1 | findstr /i "Version Compiler"

rem Generate immutable menu targets from the current descriptors before compiling.
python "%ROOT%tools\generate_menu_discovery.py"
if errorlevel 1 exit /b 1

rem Embed semver from repo root VERSION.txt into skeeto_version.generated.h
set "DLCVER=0.0.0-dev"
if exist "%ROOT%VERSION.txt" (
  for /f "usebackq tokens=1,* delims==" %%A in (`findstr /b /i /c:"semver=" "%ROOT%VERSION.txt"`) do set "DLCVER=%%B"
)
set "DLCVER=!DLCVER: =!"
if "!DLCVER!"=="" set "DLCVER=0.0.0-dev"
echo Skeeto version: !DLCVER!
(
  echo #pragma once
  echo // Auto-generated by build.bat from VERSION.txt - do not edit.
  echo #define SKEETO_VERSION "!DLCVER!"
  echo #define SKEETO_VERSION_W L"!DLCVER!"
) > "%~dp0core\skeeto_version.generated.h"

set "OUT=%ROOT%runtime\dll\skeeto.dll"
set "OUTPKG=%ROOT%packages\Skeeto\dll\skeeto.dll"
rem User-approved post-build deployment target. Keep this explicit and narrow.
rem Game deploy root priority: SKEETO_GAME_ROOT env > build.local.bat.
rem Machine-specific paths belong in build.local.bat (gitignored), not in this shared file.
rem Laptop example only (do not use as shared default): D:\Game\steamapps\common\Left 4 Dead 2
set "GAME_ROOT="
if exist "%~dp0build.local.bat" call "%~dp0build.local.bat"
if defined SKEETO_GAME_ROOT set "GAME_ROOT=%SKEETO_GAME_ROOT%"
set "OBJ=%~dp0obj"
if not exist "%OBJ%" mkdir "%OBJ%"
if not exist "%ROOT%runtime\dll" mkdir "%ROOT%runtime\dll"
if not exist "%ROOT%packages\Skeeto\dll" mkdir "%ROOT%packages\Skeeto\dll"
if not exist "%ROOT%packages\Skeeto\source" mkdir "%ROOT%packages\Skeeto\source"
if not exist "%OBJ%\cache_host" mkdir "%OBJ%\cache_host"
set "OUTHOST=%OBJ%\cache_host\skeeto_cache_host.exe"

rem Helper is our own MSVC x86 program, isolated from both game DLLs.
cl /nologo /MT /O2 /EHsc /std:c++17 /utf-8 /W3 /WX ^
  /DWIN32 /D_CRT_SECURE_NO_WARNINGS ^
  /I"%~dp0core" ^
  /Fe"%OUTHOST%" /Fo"%OBJ%\cache_host\\" /Fd"%OBJ%\cache_host\host.pdb" ^
  "%~dp0cache_host\skeeto_cache_host.cpp" ^
  /link /MACHINE:X86 /INCREMENTAL:NO /LARGEADDRESSAWARE
if errorlevel 1 exit /b 1

rem The DLL carries the exact helper from this build. No separate deployment.
rc /nologo /fo "%OBJ%\skeeto_resources.res" "%~dp0skeeto_resources.rc"
if errorlevel 1 exit /b 1

cl /nologo /LD /MT /O2 /Oy- /EHsc /std:c++17 /utf-8 /W3 /wd4100 /wd4244 /wd4458 /wd4996 ^
  /DWIN32 /D_CRT_SECURE_NO_WARNINGS /I"%~dp0plugin_sdk\include" ^
  /Fe"%OUT%" /Fo"%OBJ%\\" /Fd"%OBJ%\skeeto.pdb" ^
  "%~dp0core\skeeto_proxy.cpp" ^
  "%~dp0core\skeeto_plugins.cpp" ^
  "%~dp0core\skeeto_cache_offload.cpp" ^
  "%~dp0core\skeeto_style.cpp" ^
  "%~dp0core\skeeto_background.cpp" ^
  "%~dp0core\skeeto_elim_persist.cpp" ^
  "%~dp0core\skeeto_career.cpp" ^
  "%~dp0core\skeeto_workshop.cpp" ^
  "%~dp0core\skeeto_mainui_services.cpp" ^
  "%~dp0core\skeeto_hud.cpp" ^
  "%~dp0core\skeeto_spotlight.cpp" ^
  "%~dp0core\skeeto_navigation.cpp" ^
  "%OBJ%\skeeto_resources.res" ^
  /link /MACHINE:X86 /INCREMENTAL:NO /IMPLIB:"%OBJ%\skeeto.lib" ^
  ws2_32.lib comdlg32.lib user32.lib kernel32.lib gdi32.lib gdiplus.lib ole32.lib shell32.lib ^
  windowscodecs.lib mfplat.lib mfreadwrite.lib mfuuid.lib propsys.lib winmm.lib bcrypt.lib
if errorlevel 1 exit /b 1

copy /y "%OUT%" "%OUTPKG%" >nul
copy /y "%~dp0skeeto_resources.rc" "%ROOT%packages\Skeeto\source\skeeto_resources.rc" >nul
for %%F in (skeeto_cache_offload.cpp skeeto_cache_offload.h skeeto_cache_protocol.h) do copy /y "%~dp0core\%%F" "%ROOT%packages\Skeeto\source\%%F" >nul
if not exist "%ROOT%packages\Skeeto\source\cache_host" mkdir "%ROOT%packages\Skeeto\source\cache_host"
copy /y "%~dp0cache_host\skeeto_cache_host.cpp" "%ROOT%packages\Skeeto\source\cache_host\skeeto_cache_host.cpp" >nul
copy /y "%~dp0core\skeeto_proxy.cpp" "%ROOT%packages\Skeeto\source\skeeto_proxy.cpp" >nul
copy /y "%~dp0core\skeeto_killfeed_cs2.h" "%ROOT%packages\Skeeto\source\skeeto_killfeed_cs2.h" >nul
copy /y "%~dp0core\skeeto_killfeed_cs2_draw.inl" "%ROOT%packages\Skeeto\source\skeeto_killfeed_cs2_draw.inl" >nul
copy /y "%~dp0core\skeeto_style.cpp" "%ROOT%packages\Skeeto\source\skeeto_style.cpp" >nul
copy /y "%~dp0core\skeeto_style.h" "%ROOT%packages\Skeeto\source\skeeto_style.h" >nul
copy /y "%~dp0core\skeeto_background.cpp" "%ROOT%packages\Skeeto\source\skeeto_background.cpp" >nul
copy /y "%~dp0core\skeeto_background.h" "%ROOT%packages\Skeeto\source\skeeto_background.h" >nul
copy /y "%~dp0core\skeeto_runtime.h" "%ROOT%packages\Skeeto\source\skeeto_runtime.h" >nul
copy /y "%~dp0core\skeeto_memread.h" "%ROOT%packages\Skeeto\source\skeeto_memread.h" >nul
copy /y "%~dp0core\skeeto_fast_load.h" "%ROOT%packages\Skeeto\source\skeeto_fast_load.h" >nul
copy /y "%~dp0core\skeeto_vpk_experiments.h" "%ROOT%packages\Skeeto\source\skeeto_vpk_experiments.h" >nul
copy /y "%~dp0core\skeeto_texture_warmup.h" "%ROOT%packages\Skeeto\source\skeeto_texture_warmup.h" >nul
copy /y "%~dp0core\skeeto_mission.h" "%ROOT%packages\Skeeto\source\skeeto_mission.h" >nul
copy /y "%~dp0core\skeeto_elim_persist.cpp" "%ROOT%packages\Skeeto\source\skeeto_elim_persist.cpp" >nul
copy /y "%~dp0core\skeeto_elim_persist.h" "%ROOT%packages\Skeeto\source\skeeto_elim_persist.h" >nul
copy /y "%~dp0core\skeeto_career.cpp" "%ROOT%packages\Skeeto\source\skeeto_career.cpp" >nul
copy /y "%~dp0core\skeeto_career.h" "%ROOT%packages\Skeeto\source\skeeto_career.h" >nul
copy /y "%~dp0core\skeeto_workshop.cpp" "%ROOT%packages\Skeeto\source\skeeto_workshop.cpp" >nul
copy /y "%~dp0core\skeeto_mainui_services.cpp" "%ROOT%packages\Skeeto\source\skeeto_mainui_services.cpp" >nul
copy /y "%~dp0core\skeeto_mainui_services.h" "%ROOT%packages\Skeeto\source\skeeto_mainui_services.h" >nul
copy /y "%~dp0core\skeeto_mainui_battle_days.h" "%ROOT%packages\Skeeto\source\skeeto_mainui_battle_days.h" >nul
copy /y "%~dp0core\skeeto_mainui_report.h" "%ROOT%packages\Skeeto\source\skeeto_mainui_report.h" >nul
copy /y "%~dp0core\skeeto_damage_events.h" "%ROOT%packages\Skeeto\source\skeeto_damage_events.h" >nul
copy /y "%~dp0core\skeeto_mainui_hub.h" "%ROOT%packages\Skeeto\source\skeeto_mainui_hub.h" >nul
copy /y "%~dp0core\skeeto_mainui_config.h" "%ROOT%packages\Skeeto\source\skeeto_mainui_config.h" >nul
copy /y "%~dp0core\skeeto_workshop.h" "%ROOT%packages\Skeeto\source\skeeto_workshop.h" >nul
copy /y "%~dp0core\skeeto_host.h" "%ROOT%packages\Skeeto\source\skeeto_host.h" >nul
copy /y "%~dp0core\skeeto_hud.cpp" "%ROOT%packages\Skeeto\source\skeeto_hud.cpp" >nul
copy /y "%~dp0core\skeeto_hud.h" "%ROOT%packages\Skeeto\source\skeeto_hud.h" >nul
copy /y "%~dp0core\skeeto_spotlight.cpp" "%ROOT%packages\Skeeto\source\skeeto_spotlight.cpp" >nul
copy /y "%~dp0core\skeeto_spotlight.h" "%ROOT%packages\Skeeto\source\skeeto_spotlight.h" >nul
copy /y "%~dp0core\skeeto_navigation.cpp" "%ROOT%packages\Skeeto\source\skeeto_navigation.cpp" >nul
copy /y "%~dp0core\skeeto_navigation.h" "%ROOT%packages\Skeeto\source\skeeto_navigation.h" >nul
if not exist "%ROOT%packages\Skeeto\source\skeeto_navigation" mkdir "%ROOT%packages\Skeeto\source\skeeto_navigation"
for %%F in (sdk.h controls.h performance.h nav.h nav_incremental.h guidance.h render.h items.h minimap_ui.h map_editor.h world_navigation.h world_abi.h world_draw.h) do copy /y "%~dp0core\skeeto_navigation\%%F" "%ROOT%packages\Skeeto\source\skeeto_navigation\%%F" >nul
copy /y "%~dp0core\skeeto_navigation\CREDITS.txt" "%ROOT%packages\Skeeto\source\skeeto_navigation\CREDITS.txt" >nul
if not exist "%ROOT%packages\Skeeto\source\skeeto_navigation\supply_radar" mkdir "%ROOT%packages\Skeeto\source\skeeto_navigation\supply_radar"
for %%F in ("%~dp0core\skeeto_navigation\supply_radar\*.h" "%~dp0core\skeeto_navigation\supply_radar\CREDITS.txt") do copy /y "%%~fF" "%ROOT%packages\Skeeto\source\skeeto_navigation\supply_radar\%%~nxF" >nul
for %%F in (skeeto_mainui_layout.h skeeto_mainui_editor.h skeeto_mainui_widgets.h skeeto_mainui_native.h) do copy /y "%~dp0core\%%F" "%ROOT%packages\Skeeto\source\%%F" >nul
for %%F in (skeeto_plugins.h skeeto_plugins.cpp skeeto_plugins_menu.h) do copy /y "%~dp0core\%%F" "%ROOT%packages\Skeeto\source\%%F" >nul
copy /y "%~dp0plugin_sdk\include\skeeto_plugin_api.h" "%ROOT%packages\Skeeto\source\skeeto_plugin_api.h" >nul
for %%F in (skeeto_nativeui_config.h skeeto_nativeui_settings.h skeeto_nativeui_runtime.h skeeto_nativeui_menu.h skeeto_nativeui_commands.h) do copy /y "%~dp0core\%%F" "%ROOT%packages\Skeeto\source\%%F" >nul
for %%F in (skeeto_menu_params.h skeeto_escui_layout.h skeeto_escui_io.h skeeto_escui_editor.h skeeto_escui_native.h skeeto_escui_extras.h skeeto_escui_presets.h skeeto_escui_geometry.h) do copy /y "%~dp0core\%%F" "%ROOT%packages\Skeeto\source\%%F" >nul
for %%F in (skeeto_menu_discovery.h skeeto_menu_discovery_host.h skeeto_menu_discovery_descriptions.h skeeto_menu_catalog.generated.inc) do copy /y "%~dp0core\%%F" "%ROOT%packages\Skeeto\source\%%F" >nul
copy /y "%~dp0core\skeeto_ui_text.h" "%ROOT%packages\Skeeto\source\skeeto_ui_text.h" >nul
copy /y "%~dp0core\skeeto_tps_aim_aac.h" "%ROOT%packages\Skeeto\source\skeeto_tps_aim_aac.h" >nul
copy /y "%~dp0core\skeeto_ui_en.inc" "%ROOT%packages\Skeeto\source\skeeto_ui_en.inc" >nul
for %%F in (skeeto_bootstrap_abi.h skeeto_bootstrap_common.h skeeto_bootstrap_runtime.h skeeto_bootstrap_pe.h) do copy /y "%~dp0core\%%F" "%ROOT%packages\Skeeto\source\%%F" >nul
call "%~dp0bootstrap\build_bootstrap.bat"
if errorlevel 1 exit /b 1
echo Built %OUT%
echo Copied to %OUTPKG%
if not defined GAME_ROOT (
  echo ERROR: GAME_ROOT not set. Copy build.local.bat.example to build.local.bat, or set SKEETO_GAME_ROOT.
  echo Built %OUT% and copied to %OUTPKG%; deployment skipped.
  exit /b 0
)
if not exist "%GAME_ROOT%" (
  echo WARNING: game root not found, skipped deployment: %GAME_ROOT%
  exit /b 0
)
rem Deploy the complete managed Steam layout after exit, retaining native Necola.
powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "%ROOT%tools\bootstrap\lifecycle\skeeto_lifecycle.ps1" -Mode Migrate -PayloadRoot "%ROOT%tools\local\bootstrap\migration-package" -GameRoot "%GAME_ROOT%" -NonInteractive
if errorlevel 1 exit /b 2
fc /b "%OUT%" "%GAME_ROOT%\skeeto.dll" >nul
if errorlevel 1 (
  echo ERROR: game-root skeeto.dll verification failed.
  exit /b 2
)
fc /b "%ROOT%runtime\bootstrap\wininet.dll" "%GAME_ROOT%\bin\wininet.dll" >nul
if errorlevel 1 (
  echo ERROR: game-bin wininet.dll verification failed.
  exit /b 2
)
echo Deployed and verified root core and Steam proxy in %GAME_ROOT%
exit /b 0
